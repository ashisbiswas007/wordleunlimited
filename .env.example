# ---- copy to .env for local dev; in Coolify set these as environment variables ----

# Public origin. Used for canonical URLs, sitemap, challenge links and OAuth redirect.
SITE_URL=https://wordleunlimited.dev

PORT=3000
NODE_ENV=production

# Behind Coolify's Traefik proxy this must be 1 so rate limiting sees real client IPs.
TRUST_PROXY=1

# ---- database ----
# Coolify: create a PostgreSQL resource and paste its internal connection string.
DATABASE_URL=postgres://wordle:changeme@db:5432/wordle
POSTGRES_PASSWORD=changeme

# ---- sessions / admin ----
# Random 64-char hex. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin panel lives at /admin
ADMIN_USER=admin

# Simplest option: type the password you want here. It is hashed at boot and the
# plain text is never written to the database or to disk.
ADMIN_PASSWORD=

# Leave BOTH admin password variables blank and a strong password is generated on
# first boot and printed to the container logs (once). Useful for a first deploy.

# More secure option: pre-hash it so no plain text ever sits in the environment.
#   node scripts/hash-password.mjs "your password"
# Takes precedence over ADMIN_PASSWORD. A password changed inside /admin
# outranks both, because it is stored in the database.
ADMIN_PASSWORD_HASH=

# ---- Google Drive cloud save ----
# Google Cloud Console > Credentials > OAuth 2.0 Client ID (Web application)
# Authorised JavaScript origin:  https://wordleunlimited.dev
# Scopes used: openid, profile, https://www.googleapis.com/auth/drive.appdata
# This is a public client id — it is safe to expose to the browser.
GOOGLE_CLIENT_ID=
